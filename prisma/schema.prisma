generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GuestStatus {
  PENDING
  ACTIVE
}

model Guest {
  id                 String      @id @default(cuid())
  phone              String      @unique
  name               String
  genre              String      @default("Cher")
  token              String      @unique
  deviceId           String?     @unique @map("device_id")
  status             GuestStatus @default(PENDING)
  statusSend         Boolean     @default(false) @map("status_send")
  sendBlocked        Boolean     @default(false) @map("send_blocked")
  availability       Boolean?
  outsideUsa         Boolean?    @map("outside_usa")
  peopleCount        Int?        @map("people_count")
  needInvitation     Boolean     @default(false) @map("need_invitation")
  needVisaAssistance Boolean     @default(false) @map("need_visa_assistance")
  needHotelBooking   Boolean     @default(false) @map("need_hotel_booking")
  checkedInAt        DateTime?   @map("checked_in_at")
  checkedInCount     Int?        @map("checked_in_count")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  tableAssignment    TableAssignment?
  drinkServings      DrinkServing[]
  usherCalls         UsherCall[]

  @@map("guests")
}

model WeddingTable {
  id            String            @id @default(cuid())
  name          String
  seatCount     Int               @map("seat_count")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  assignments   TableAssignment[]
  drinkServings DrinkServing[]
  drinkOrders   DrinkOrder[]
  usherCalls    UsherCall[]

  @@map("wedding_tables")
}

model DrinkItem {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  unit      String         @default("verre")
  sortOrder Int            @default(0) @map("sort_order")
  active    Boolean        @default(true)
  servings    DrinkServing[]
  orderItems  DrinkOrderItem[]

  @@map("drink_items")
}

model DrinkServing {
  id        String       @id @default(cuid())
  tableId   String       @map("table_id")
  drinkId   String       @map("drink_id")
  quantity  Int          @default(1)
  guestId   String?      @map("guest_id")
  createdAt DateTime     @default(now()) @map("created_at")
  table     WeddingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  drink     DrinkItem    @relation(fields: [drinkId], references: [id], onDelete: Cascade)
  guest     Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([tableId, drinkId])
  @@index([createdAt])
  @@map("drink_servings")
}

enum DrinkOrderStatus {
  PENDING
  PREPARING
  READY
  PICKED_UP
  CANCELLED
}

model DrinkOrder {
  id        String           @id @default(cuid())
  tableId   String           @map("table_id")
  status    DrinkOrderStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  table     WeddingTable     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items     DrinkOrderItem[]

  @@index([status, createdAt])
  @@map("drink_orders")
}

model DrinkOrderItem {
  id       String     @id @default(cuid())
  orderId  String     @map("order_id")
  drinkId  String     @map("drink_id")
  quantity Int
  order    DrinkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  drink    DrinkItem  @relation(fields: [drinkId], references: [id], onDelete: Restrict)

  @@map("drink_order_items")
}

enum UsherCallStatus {
  WAITING
  TAKEN
  SEATED
  CANCELLED
}

model UsherCall {
  id        String          @id @default(cuid())
  guestId   String          @map("guest_id")
  tableId   String?         @map("table_id")
  status    UsherCallStatus @default(WAITING)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  guest     Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  table     WeddingTable?   @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("usher_calls")
}

model TableAssignment {
  id              String       @id @default(cuid())
  tableId         String       @map("table_id")
  guestId         String       @unique @map("guest_id")
  invitationSent  Boolean      @default(false) @map("invitation_sent")
  createdAt       DateTime     @default(now()) @map("created_at")
  table           WeddingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest           Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("table_assignments")
}
